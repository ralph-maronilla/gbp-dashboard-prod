# ---- Database (PostgreSQL) ----
# Local development: any PostgreSQL 16+ (for example Postgres.app) with an empty database, then `npx prisma migrate deploy`.
# Production: the managed Lightsail PostgreSQL endpoint. Server-only; never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gbp_dashboard
# Same server, used by the Prisma CLI (`prisma migrate deploy`). Normally identical to DATABASE_URL.
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/gbp_dashboard
# Managed databases require TLS. Verify it with the provider's CA bundle: a file path, or the PEM text with newlines as \n.
# DATABASE_CA_FILE=/etc/ssl/certs/lightsail-db-ca.pem
# DATABASE_CA_CERT=
# Local development only, when your local server insists on TLS with a self-signed certificate:
# DATABASE_SSL_NO_VERIFY=true
# Connections the app keeps open (default 10). Keep it well under the database's connection limit.
# DATABASE_POOL_MAX=10

# ---- Sign-in ----
# Signs session cookies and one-time email links. 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical public origin of this app; used for the CSRF Origin check and for links in emails.
# Required in production (https://your-domain). Local development: http://localhost:3000
APP_URL=http://localhost:3000

# ---- Email (SMTP) ----
# Confirmation and password-reset emails. Leave SMTP_HOST empty in development: the emails (with their links) are
# printed in the server log instead. Production refuses to start sending without it.
SMTP_HOST=
SMTP_PORT=587                      # 587 = STARTTLS, 465 = implicit TLS
# SMTP_SECURE=false                # true for implicit TLS; defaults to true on port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GBP Review Dashboard <no-reply@your-domain>"

# ---- Automatic extraction ----
# The scheduler (a systemd timer on the server) sends "Authorization: Bearer $CRON_SECRET" to /api/cron/sync every
# 15 minutes. openssl rand -hex 32
CRON_SECRET=
# Where the server reaches itself when a big extraction continues in the background. Defaults to APP_URL.
# INTERNAL_APP_URL=http://127.0.0.1:3000

# Time zone for the review CSV export (date column and from/to filters). IANA name; default Asia/Manila.
# EXPORT_TIMEZONE=Asia/Manila

# ---- Review extraction through Serper (google.serper.dev) ----
SERPER_API_KEY=
# SERPER_GL=ph                      # country for search/reviews
# SERPER_HL=en                      # language
# SERPER_CONCURRENCY=4              # locations fetched in parallel per run (1-10)
# SERPER_MAX_CREDITS_PER_RUN=500    # 1 credit = 1 page of 20 reviews
# SERPER_DAILY_CREDIT_LIMIT=5000    # extraction stops for the day after this many credits (UTC day)
# SERPER_USER_DAILY_CREDIT_LIMIT=200  # one person's share of that per day (Extract and Google refresh)
# SYNC_MAX_CHAIN=50                 # max automatic back-to-back runs to finish a big extraction

# ---- Google Sheet mirror of the reviews (optional; see "Google Sheet mirror" in deploy/RUNBOOK.md) ----
# Leave all three empty to keep it off. The sheet must be shared with the service account's email as Editor.
# GOOGLE_SHEETS_SPREADSHEET_ID=          # the long id in the sheet's address: docs.google.com/spreadsheets/d/<THIS>/edit
# GOOGLE_SERVICE_ACCOUNT_EMAIL=          # "client_email" in the service account's JSON key file
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=    # "private_key" in that file, on one line with its \n kept, in double quotes

# Development only: sign out after this many idle minutes instead of 60 (ignored in production). For testing the idle sign-out.
# NEXT_PUBLIC_IDLE_MINUTES=2

# ---- Tests (npm run test:db) ----
# A throwaway database whose name ends in _test; it is wiped and rebuilt on every run. Defaults to a local Postgres.app database.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gbp_dashboard_test
# Browser tests (npm run test:e2e) use their own database, app server and a stand-in for Serper, all started by Playwright.
# E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gbp_dashboard_e2e_test
