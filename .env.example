# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key   # legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY also works

# Postgres via Prisma (Supabase → Connect → ORMs / connection string).
# DATABASE_URL: "Transaction pooler" string (port 6543) used by the app at runtime.
# DIRECT_URL:   "Direct connection" (or Session pooler) string, only used by the Prisma CLI (`prisma db pull`).
# Both contain your database password. Server-only; never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# If you see "self-signed certificate in certificate chain": set DATABASE_CA_CERT to the Supabase CA PEM
# (newlines as \n), or for local dev only: DATABASE_SSL_NO_VERIFY=true
# DATABASE_CA_CERT=
# DATABASE_SSL_NO_VERIFY=

# Canonical origin of this app; used for the CSRF Origin check and email redirects.
# Required in production. Local dev: http://localhost:3000
APP_URL=http://localhost:3000

# Optional now, recommended in production (shared rate limiting across serverless instances).
# Without these, an in-memory limiter is used (per instance; fine for dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Needed for automatic extraction: the Supabase pg_cron job sends "Authorization: Bearer $CRON_SECRET" to
# /api/cron/sync (README step 6). openssl rand -hex 32
CRON_SECRET=

# Time zone for the review CSV export (date column and from/to filters). IANA name; default Asia/Manila.
# EXPORT_TIMEZONE=Asia/Manila

# --- Review extraction through Serper (google.serper.dev) ---
SERPER_API_KEY=
# SERPER_GL=ph                      # country for search/reviews
# SERPER_HL=en                      # language
# SERPER_CONCURRENCY=4              # locations fetched in parallel per run (1-10)
# SERPER_MAX_CREDITS_PER_RUN=500    # 1 credit = 1 page of 20 reviews
# SERPER_DAILY_CREDIT_LIMIT=5000    # extraction stops for the day after this many credits (UTC day)
# SERPER_USER_DAILY_CREDIT_LIMIT=200  # one person's share of that per day (Extract and Google refresh)
# SYNC_MAX_CHAIN=50                 # max automatic back-to-back runs to finish a big extraction

# Development only: sign out after this many idle minutes instead of 60 (ignored in production). For testing the idle sign-out.
# NEXT_PUBLIC_IDLE_MINUTES=2
