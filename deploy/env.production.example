# /etc/gbp-dashboard/env: the app's settings on the server. Owned by root, readable by the `gbp` group only (mode 640).
# systemd reads this file as plain KEY=value lines: no `export`, no quotes needed (quotes would become part of the value).

# ---- Database: the managed Lightsail PostgreSQL ----
# Use the endpoint and master user from the Lightsail console. URL-encode special characters in the password
# (@ -> %40, / -> %2F, : -> %3A, # -> %23, ? -> %3F). Do NOT add ?sslmode=...: TLS is verified with the CA file below.
DATABASE_URL=postgresql://dbmasteruser:PASSWORD@ls-XXXXXXXX.XXXXXXXX.REGION.rds.amazonaws.com:5432/postgres
DIRECT_URL=postgresql://dbmasteruser:PASSWORD@ls-XXXXXXXX.XXXXXXXX.REGION.rds.amazonaws.com:5432/postgres
DATABASE_CA_FILE=/etc/ssl/certs/rds-global-bundle.pem
DATABASE_POOL_MAX=10

# ---- Sign-in ----
# openssl rand -base64 32     (make a NEW one for production; changing it later signs everyone out)
BETTER_AUTH_SECRET=
# The public address people type, with https:// and no trailing slash. Required.
APP_URL=https://reviews.example.com
# Where the app calls itself when a big extraction continues in the background (skips the trip out to the internet).
INTERNAL_APP_URL=http://127.0.0.1:3000

# ---- Email (SMTP) ----
# Required in production: confirmation and password-reset emails cannot be sent without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GBP Review Dashboard <no-reply@example.com>

# ---- Automatic extraction ----
# openssl rand -hex 32     (the timer sends this to /api/cron/sync)
CRON_SECRET=

# ---- Serper ----
SERPER_API_KEY=
# EXPORT_TIMEZONE=Asia/Manila
# SERPER_DAILY_CREDIT_LIMIT=5000
# SERPER_USER_DAILY_CREDIT_LIMIT=200
